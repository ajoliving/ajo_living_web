# HTTP service local development environment.
# 1. PostgreSQL settings used by docker-compose.yml.
# 2. DB_DSN used by cmd/server when running on the host machine.
# 3. Local providers for auth, upload, and email flows.

APP_ENV=development
APP_PORT=8081
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_API_PUBLIC_BASE_URL=http://localhost:8081

POSTGRES_DB=ajoliving
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6382

DB_DRIVER=postgres
DB_DSN=host=127.0.0.1 user=postgres password=postgres dbname=ajoliving port=5432 sslmode=disable TimeZone=Asia/Shanghai
REDIS_ENABLED=true
REDIS_ADDR=127.0.0.1:6382
REDIS_PASSWORD=
REDIS_DB=0
ISMART_BUILDING_CACHE_TTL=5m

JWT_SECRET=dev-secret-key
ENCRYPTION_KEY=dev-encryption-key
BOOTSTRAP_STAFF_PHONES=
# POS_LOGIN_URL can stay empty; the service derives it from POS_API_BASE_URL + /poslogin.
POS_LOGIN_URL=
POS_API_BASE_URL=https://pos.ismart.skylinedances.com/api
POS_API_USERNAME=testowner02
POS_API_PASSWORD=test02test02
POS_API_LOGIN_TYPE=username
POS_LOGIN_USERNAME_FIELD=login_name
POS_LOGIN_PASSWORD_FIELD=password
POS_LOGIN_TIMEOUT=10s
POS_DIRECTORY_CACHE_TTL=5m
POS_PAYMENT_SERVICE_URL=https://easy.payment.skylinedances.com/api/payments
ISMART_EXTERNAL_APP_BASE_URL=https://ismart.ajoliving.com
ISMART_EXTERNAL_APP_API_BASE_URL=https://ismart.ajoliving.com/api/v1/external
ISMART_INTEGRATION_API_BASE_URL=https://ismart.ajoliving.com/api/v1/integration
ISMART_SERVICE_CASE_API_BASE_URL=https://clouddev.ismart.ajoliving.com/api/v1/integration
ISMART_EXTERNAL_APP_TIMEOUT=10s
ICCTV_API_BASE_URL=https://icctv.skylinedances.com/api
ICCTV_ADMIN_USERNAME=admin
ICCTV_ADMIN_PASSWORD=admin123
ICCTV_REQUEST_TIMEOUT=10s
ICCTV_STREAM_PROXY_BASE_URL=https://icctv.skylinedances.com
POS_TERMINAL_PROXY_ENABLED=false
POS_TERMINAL_TYPE=allinpay
POS_TERMINAL_URL=
POS_TERMINAL_ALLOWED_BUILDINGS=
GOOD_PRICE_API_BASE_URL=https://good.price.skylinedances.com/api
GOOD_PRICE_REQUEST_TIMEOUT=10s
GOOD_PRICE_CACHE_TTL=5m
GOOD_PRICE_SUMMARY_CACHE_TTL=5m
GOOD_PRICE_SEARCH_CACHE_TTL=2m
GOOD_PRICE_DETAIL_CACHE_TTL=3m
GOOD_PRICE_ALERT_ENABLED=true
GOOD_PRICE_ALERT_INTERVAL=1h

TRANSLATION_PROVIDER=disabled
DEEPL_API_BASE_URL=https://api-free.deepl.com
DEEPL_AUTH_KEY=
TRANSLATION_REQUEST_TIMEOUT=10s

OTP_PROVIDER=mock
OTP_MOCK_CODE=123456
OTP_RESEND_COOLDOWN=1m
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE_CN=
ALIYUN_SMS_TEMPLATE_PARAM_NAME=code
ALIYUN_SMS_REQUEST_TIMEOUT=10s

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_HELLO_NAME=localhost

OSS_PROVIDER=oss
OSS_BUCKET=ajo-living
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_REGION=cn-hongkong
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_SESSION_TOKEN=
OSS_USE_CNAME=false
OSS_DISABLE_SSL=false
OSS_PRESIGN_EXPIRES=15m
OSS_MEDIA_BASE_URL=https://ajo-living.oss-cn-hongkong.aliyuncs.com
OSS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OSS_CALLBACK_ENABLED=false
OSS_CALLBACK_URL=http://localhost:8081/api/v1/oss/callback

SEED_COMMUNITIES=true
ENABLE_EXPIRE_TICKER=true
EXPIRE_TICKER_INTERVAL=1h

WALLET_RECHARGE_ENABLED=true
WALLET_RECHARGE_RETURN_BASE_URL=http://localhost:5173
WALLET_RECHARGE_NOTIFY_URL=http://localhost:8081/api/v1/payments/easylink/notify
EASYLINK_ENV=sandbox
EASYLINK_BASE_URL=https://ts-api-pay.gnete.com.hk
EASYLINK_MCH_NO=
EASYLINK_H5_APP_ID=
EASYLINK_H5_APP_SECRET=
EASYLINK_WX_H5_CHANNEL_APP_ID=
EASYLINK_ALI_H5_WALLET_TYPE=HK
EASYLINK_YSF_QR_APP_ID=
EASYLINK_YSF_QR_APP_SECRET=
EASYLINK_EXPIRED_SECONDS=180
EASYLINK_TIMEOUT_MS=15000
