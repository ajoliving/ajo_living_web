# HTTP service local development environment.
# 1. PostgreSQL settings used by docker-compose.yml.
# 2. DB_DSN used by cmd/server when running on the host machine.
# 3. Local providers for auth, upload, and email flows.

APP_ENV=development
APP_PORT=8080
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_API_PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_DB=ajoliving
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

DB_DRIVER=postgres
DB_DSN=host=127.0.0.1 user=postgres password=postgres dbname=ajoliving port=5432 sslmode=disable TimeZone=Asia/Shanghai

JWT_SECRET=dev-secret-key
ENCRYPTION_KEY=dev-encryption-key
BOOTSTRAP_STAFF_PHONES=

OTP_PROVIDER=mock
OTP_MOCK_CODE=123456

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_HELLO_NAME=localhost

OSS_PROVIDER=oss
OSS_BUCKET=ajo-living
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_REGION=cn-hongkong
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_SESSION_TOKEN=
OSS_USE_CNAME=false
OSS_DISABLE_SSL=false
OSS_PRESIGN_EXPIRES=15m
OSS_MEDIA_BASE_URL=https://ajo-living.oss-cn-hongkong.aliyuncs.com
OSS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OSS_CALLBACK_ENABLED=false
OSS_CALLBACK_URL=http://localhost:8080/api/v1/oss/callback

SEED_COMMUNITIES=true
ENABLE_EXPIRE_TICKER=true
EXPIRE_TICKER_INTERVAL=1h
