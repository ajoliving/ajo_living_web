function validatePhone(){
  var v=document.getElementById('login-phone').value.replace(/[\s\-+]/g,'');
  var fg=document.getElementById('fg-phone');
  if(!fg)return;
  if(v.length===0){fg.classList.remove('error','success');return;}
  var ok=/^[0-9]{8}$/.test(v)||/^852[0-9]{8}$/.test(v);
  fg.classList.toggle('error',!ok);
  fg.classList.toggle('success',ok);
}
function validatePw(){
  var v=document.getElementById('login-pw').value;
  var fg=document.getElementById('fg-pw');
  if(!fg)return;
  if(v.length===0){fg.classList.remove('error','success');return;}
  fg.classList.toggle('error',v.length<6);
  fg.classList.toggle('success',v.length>=6);
}
function submitLogin(e){
  e.preventDefault();
  validatePhone();validatePw();
  var pe=document.getElementById('fg-phone');
