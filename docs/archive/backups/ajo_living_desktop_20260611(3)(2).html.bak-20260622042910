.d-hero-right{flex:0 0 420px}
.d-hero-stats{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.d-hs{background:var(--sur);border:0.5px solid var(--bdr);border-radius:var(--r);padding:20px}
.d-hs.accent{background:linear-gradient(135deg,#1A1A2E,#2A1A10);border-color:transparent;grid-column:span 2;display:flex;align-items:center;justify-content:space-between}

.d-stats-row{display:grid;grid-template-columns:repeat(3,1fr);background:var(--sur);border-top:0.5px solid var(--bdr);border-bottom:0.5px solid var(--bdr)}
