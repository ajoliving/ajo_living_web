    frame.removeAttribute('src');
    delete frame.dataset.currentUrl;
  }
}

function refreshIcctvPanel(panelId){
  var panel=document.getElementById(panelId);
  if(!panel)return;
  var frames=panel.querySelectorAll('.icctv-inline-viewer iframe');
  if(frames.length){
    frames.forEach(function(frame){
      var src=frame.getAttribute('src');
      frame.setAttribute('src',src);
    });
    showToast('監控畫面已重新載入');
  }else{
    showToast('請先選擇鏡頭','error');
  }
}

function openIcctvWindow(panelId){
  var panel=document.getElementById(panelId);
  if(!panel)return;
  var frame=panel.querySelector('.icctv-inline-viewer iframe');
  if(frame&&frame.getAttribute('src')){
    window.open(frame.getAttribute('src'),'_blank','noopener');
  }else{
    showToast('請先選擇鏡頭','error');
  }
}

function initIcctvPanels(){
  ['profile-icctv','management-icctv','affairs-icctv'].forEach(function(panelId){
    var panel=document.getElementById(panelId);
    if(!panel)return;
    panel.dataset.icctvBuilding='0';
    panel.dataset.icctvOpen='';
    renderIcctvPanel(panelId);
  });
}

document.addEventListener('change',function(e){
  var select=e.target.closest('[data-icctv-building-select]');
  if(!select)return;
  var panelId=select.getAttribute('data-icctv-building-select');
  var panel=document.getElementById(panelId);
  if(!panel)return;
  panel.dataset.icctvBuilding=select.value;
  panel.dataset.icctvOpen='';
  renderIcctvPanel(panelId);
});

document.addEventListener('click',function(e){
  var openUrl=e.target.closest('[data-icctv-open-url]');
  if(openUrl){
    window.open(openUrl.getAttribute('data-icctv-open-url'),'_blank','noopener');
    return;
  }
  var btn=e.target.closest('[data-icctv-camera-index]');
  if(!btn)return;
  var panelId=btn.getAttribute('data-icctv-panel');
  var panel=document.getElementById(panelId);
  if(!panel)return;
  var cameraIndex=parseInt(btn.getAttribute('data-icctv-camera-index'),10);
  var openList=(panel.dataset.icctvOpen||'').split(',').filter(function(x){return x!=='';}).map(function(x){return parseInt(x,10);});
  if(openList.indexOf(cameraIndex)>-1){
    openList=openList.filter(function(x){return x!==cameraIndex;});
  }else{
    openList.push(cameraIndex);
  }
  panel.dataset.icctvOpen=openList.join(',');
  renderIcctvPanel(panelId);
});

document.addEventListener('DOMContentLoaded',initIcctvPanels);

