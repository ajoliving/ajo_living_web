var lbImgs=['linear-gradient(135deg,#e8e8e8,#d0d0d0)','linear-gradient(135deg,#e0e4e8,#c8d0d8)','linear-gradient(135deg,#e8e4e0,#d0c8c0)','linear-gradient(135deg,#e0e8e0,#c8d8c8)'];
var lbIdx=0;
function openLB(i){lbIdx=i||0;updateLB();document.getElementById('lightbox').classList.add('open');}
function closeLB(){document.getElementById('lightbox').classList.remove('open');}
function updateLB(){
  var img=document.getElementById('lb-img');
  img.style.background=lbImgs[lbIdx];
  document.getElementById('lb-counter').textContent=(lbIdx+1)+' / '+lbImgs.length;
  var thumbs=document.getElementById('lb-thumbs');
  thumbs.innerHTML='';
  lbImgs.forEach(function(bg,i){
    var t=document.createElement('div');
    t.style.cssText='width:48px;height:36px;border-radius:3px;cursor:pointer;border:2px solid '+(i===lbIdx?'var(--accent)':'transparent')+';background:'+bg+';';
    t.onclick=function(){lbIdx=i;updateLB();};
    thumbs.appendChild(t);
  });
}
function lbPrev(){lbIdx=(lbIdx-1+lbImgs.length)%lbImgs.length;updateLB();}
function lbNext(){lbIdx=(lbIdx+1)%lbImgs.length;updateLB();}
document.addEventListener('keydown',function(e){
  if(document.getElementById('lightbox').classList.contains('open')){
    if(e.key==='ArrowLeft')lbPrev();
    if(e.key==='ArrowRight')lbNext();
    if(e.key==='Escape')closeLB();
  }
  if(document.getElementById('price-modal').classList.contains('open')&&e.key==='Escape'){
    document.getElementById('price-modal').classList.remove('open');
  }
  if(document.getElementById('lightbox').classList.contains('open')||document.getElementById('price-modal').classList.contains('open')){e.preventDefault&&e.preventDefault();}
});

