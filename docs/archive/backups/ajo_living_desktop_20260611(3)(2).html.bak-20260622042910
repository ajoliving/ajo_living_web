// ══════════════════════════════════════
var revealObserver = new IntersectionObserver(function(entries) {
  entries.forEach(function(entry) {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

function initReveal() {
  document.querySelectorAll('.gc, .mc, .gp-card, .cat-card, .feat-card, .district-card, .offer-card, .sv-card, .notif-item, .trend-header, .gp-stat-card').forEach(function(el, i) {
    el.classList.add('reveal');
    el.style.transitionDelay = Math.min(i * 0.05, 0.3) + 's';
    revealObserver.observe(el);
  });
}
// Re-init on page switch
// reveal handled inline in main go()
setTimeout(initReveal, 300);

// ══════════════════════════════════════
// NUMBER COUNTER ANIMATION
// ══════════════════════════════════════
function animateNum(el, target, suffix) {
  suffix = suffix || '';
  var start = 0;
  var duration = 1000;
  var startTime = null;
  function step(ts) {
    if (!startTime) startTime = ts;
    var progress = Math.min((ts - startTime) / duration, 1);
    var eased = 1 - Math.pow(1 - progress, 3);
    var val = Math.round(eased * target);
    el.textContent = val.toLocaleString() + suffix;
    if (progress < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function initCounters() {
  document.querySelectorAll('.gp-stat-num, .hero-stat-num, .sm-stat-num').forEach(function(el) {
    var raw = el.textContent.replace(/,/g,'').replace(/[^0-9.]/g,'');
    var num = parseFloat(raw);
    var suffix = el.textContent.replace(/[0-9,\.]/g,'').trim();
    if (!isNaN(num) && num > 0) {
      var obs = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) { animateNum(el, num, suffix); obs.disconnect(); }
      }, { threshold: 0.5 });
      obs.observe(el);
    }
  });
}
setTimeout(initCounters, 400);

