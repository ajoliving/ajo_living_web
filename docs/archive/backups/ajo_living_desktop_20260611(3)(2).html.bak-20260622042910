var priceAlerts = [];
var currentAlertProp = '';

function openAlertModal(name, currentPrice) {
  currentAlertProp = name;
  document.getElementById('alert-prop-name').textContent = name;
  document.getElementById('alert-current').textContent = '現時月租：' + currentPrice;
  document.getElementById('alert-target-input').value = '';
  renderAlertList();
  document.getElementById('alert-modal').classList.add('open');
}

function closeAlertModal() {
  document.getElementById('alert-modal').classList.remove('open');
}

function saveAlert() {
  var val = parseInt(document.getElementById('alert-target-input').value);
  if (!val || val < 1000) { showToast('請輸入有效目標價', 'error'); return; }
  // Remove existing alert for same property
  priceAlerts = priceAlerts.filter(function(a){ return a.name !== currentAlertProp; });
  priceAlerts.push({ name: currentAlertProp, target: val });
  renderAlertList();
  showToast('✓ 提醒已設定：低於 HK$' + val.toLocaleString(), 'success');
  closeAlertModal();
  // Also add to notifications
  var notifMain = document.querySelector('.notif-main');
  if(notifMain) {
    var item = document.createElement('div');
    item.className = 'notif-item unread';
    item.innerHTML = '<div class="notif-dot"></div><div class="notif-icon orange">🔔</div><div class="notif-content"><div class="notif-title">目標價提醒已設定</div><div class="notif-desc">'+currentAlertProp+'：當月租低於 HK$'+val.toLocaleString()+' 時通知你。</div><div class="notif-time">剛剛</div></div>';
    var firstGroup = notifMain.querySelector('.notif-list');
    if(firstGroup) firstGroup.prepend(item);
  }
}

function removeAlert(i) {
  priceAlerts.splice(i, 1);
  renderAlertList();
  showToast('已移除提醒');
}

function renderAlertList() {
  var c = document.getElementById('alert-active-items');
  if (!c) return;
  if (priceAlerts.length === 0) { c.innerHTML = '<div style="font-size:11px;color:var(--ink-4);padding:8px 0;">暫無設定嘅提醒</div>'; return; }
  c.innerHTML = priceAlerts.map(function(a, i) {
    return '<div class="alert-active-item"><span class="alert-active-name">'+a.name+'</span><span class="alert-active-price">< HK$'+a.target.toLocaleString()+'</span><button class="alert-active-rm" onclick="removeAlert('+i+')">✕</button></div>';
  }).join('');
}

var alertModalEl=document.getElementById('alert-modal');
if(alertModalEl){alertModalEl.addEventListener('click', function(e){ if(e.target===this) closeAlertModal(); });}

