function sendChat(){
  var input=document.getElementById('chat-input');
  if(!input||!input.value.trim())return;
  addChatMsg(input.value,'user');
  input.value='';
  setTimeout(function(){addChatMsg('收到你嘅訊息，客服人員會盡快回覆你！','bot');},800);
}
function addChatMsg(text,type){
  var msgs=document.getElementById('chat-messages');
  var msg=document.createElement('div');
  msg.className='chat-msg '+type;
  msg.textContent=text;
  msgs.appendChild(msg);
  msgs.scrollTop=msgs.scrollHeight;
}

// ══ CALCULATOR ══
function toggleCalc(){document.getElementById('calc-window').classList.toggle('open');}
function updateCalc(){
  var rent=parseFloat(document.getElementById('calc-rent').value)||0;
  var income=parseFloat(document.getElementById('calc-income').value)||0;
  var area=parseFloat(document.getElementById('calc-area').value)||0;
  document.getElementById('cr-annual').textContent=rent?'HK$'+Math.round(rent*12).toLocaleString():'—';
  document.getElementById('cr-psf').textContent=(rent&&area)?'HK$'+(rent/area).toFixed(1)+'/呎':'—';
  if(rent&&income){
    var ratio=Math.round(rent/income*100);
    var el=document.getElementById('cr-ratio');
    el.textContent=ratio+'%';
    el.className='calc-result-val '+(ratio>40?'warn':ratio>30?'':'ok');
    document.getElementById('cr-advice').textContent=ratio>40?'⚠ 超出建議上限':ratio>30?'注意：略高':'✓ 合理範圍';
    document.getElementById('cr-advice').className='calc-result-val '+(ratio>40?'warn':ratio>30?'':'ok');
  } else {
    document.getElementById('cr-ratio').textContent='—';
    document.getElementById('cr-advice').textContent='—';
  }
}

