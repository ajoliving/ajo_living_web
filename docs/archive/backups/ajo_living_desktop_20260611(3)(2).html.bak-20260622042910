function validatePhone(){
  var input=document.getElementById('login-phone');
  var fg=document.getElementById('fg-phone');
  if(!input||!fg)return;
  var digits=input.value.replace(/[^0-9]/g,'');
  if(input.value.length===0){fg.className='form-group';}
  else if(digits.length>=8){fg.className='form-group success';}
  else{fg.className='form-group error';}
}
function validatePwd(){
  var input=document.getElementById('login-pwd');
  var fg=document.getElementById('fg-pwd');
  if(!input||!fg)return;
  if(input.value.length===0){fg.className='form-group';}
  else if(input.value.length>=6){fg.className='form-group success';}
  else{fg.className='form-group error';}
}

