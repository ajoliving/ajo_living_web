    grid.innerHTML = "<div class=\"saved-empty\" style=\"grid-column:1/-1\"><div class=\"saved-empty-icon\">❤️</div><div class=\"saved-empty-title\">收藏清單係空嘅</div><div class=\"saved-empty-desc\">瀏覽樓盤時點擊「♡ 收藏」即可加入</div><button class=\"nav-login ripple-host\" onclick=\"go('listing')\">去搜尋樓盤</button></div>";
