/* Desktop Payment */
.d-pay-page{padding:40px}
.d-pay-layout{display:grid;grid-template-columns:1fr 380px;gap:28px;max-width:960px}
.d-payment-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;max-width:760px;margin:0 auto 28px}
.d-payment-step{position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;color:var(--ink3);font-size:12px;font-weight:600}
.d-payment-step:not(:last-child)::after{content:'';position:absolute;top:15px;left:calc(50% + 24px);right:calc(-50% + 24px);height:1px;background:var(--bdr2)}
.d-payment-step-num{position:relative;z-index:1;width:30px;height:30px;border-radius:50%;background:var(--sur);border:1px solid var(--bdr2);color:var(--ink3);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800}
.d-payment-step.is-active{color:var(--br)}
.d-payment-step.is-active .d-payment-step-num{background:var(--br);border-color:var(--br);color:#fff}
.d-section-label{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);margin-bottom:10px}
.d-pay-card{background:var(--sur);border-radius:var(--r);border:0.5px solid var(--bdr);overflow:hidden;margin-bottom:20px}
.d-pay-item{display:flex;align-items:center;gap:14px;padding:16px 20px;transition:.1s}
.d-pay-item:hover{background:var(--sur2)}
.d-pay-item+.d-pay-item{border-top:0.5px solid var(--bdr)}
.d-pay-ico{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.d-pay-check{width:24px;height:24px;border-radius:7px;background:var(--brl);border:0.5px solid var(--brm);display:flex;align-items:center;justify-content:center;color:var(--br);font-size:13px;flex-shrink:0;font-weight:700;margin-left:8px}
.d-pay-total{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-top:0.5px solid var(--bdr2)}
.d-method-opt{display:flex;align-items:center;gap:12px;padding:14px 16px;border:1.5px solid var(--bdr);border-radius:12px;cursor:pointer;transition:.15s;background:var(--sur);margin-bottom:10px}
.d-method-opt.sel{border-color:var(--br);background:var(--brl)}
.d-method-opt:hover{border-color:var(--brm)}
.d-radio{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--bdr2);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.15s}
.d-method-opt.sel .d-radio{border-color:var(--br);background:var(--br)}
.d-rdot{width:7px;height:7px;border-radius:50%;background:#fff}
.d-mlogo{font-size:11px;font-weight:700;background:var(--ink);color:#fff;border-radius:6px;padding:4px 8px}
.d-fps{background:#E31837}
.d-coin-box{background:var(--brl);border:0.5px solid var(--brm);border-radius:var(--r);padding:18px 20px;display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.d-confirm-btn{width:100%;background:var(--br);color:#fff;border:none;border-radius:var(--rm);padding:16px;font-size:15px;font-weight:600;cursor:pointer;font-family:'Noto Sans TC',sans-serif;transition:.15s}
.d-confirm-btn:hover{background:var(--brd)}

/* Desktop Coin */
.d-coin-hero{background:linear-gradient(135deg,var(--br),#E8440A);padding:60px 40px;display:flex;align-items:center;gap:60px}
.d-coin-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:40px 40px 0}
.d-coin-stat{background:var(--sur);border:0.5px solid var(--bdr);border-radius:var(--r);padding:24px;text-align:center}
.d-coin-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:32px 40px}
.d-coin-step{background:var(--sur);border:0.5px solid var(--bdr);border-radius:var(--r);padding:24px}
.d-step-num{width:30px;height:30px;border-radius:50%;background:var(--br);color:#fff;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-bottom:14px}
.d-redeem-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;padding:0 40px 40px}
.d-redeem-card{background:var(--sur);border:0.5px solid var(--bdr);border-radius:var(--r);padding:24px;text-align:center;cursor:pointer;transition:.15s}
.d-redeem-card:hover{border-color:var(--brm);background:var(--brl)}

/* Desktop Login */
.d-auth{display:flex;min-height:calc(100vh - 60px)}
.d-auth-left{flex:1;background:linear-gradient(140deg,#1A1A2E,#2A1A10);display:flex;flex-direction:column;justify-content:center;padding:60px}
.d-auth-right{flex:0 0 480px;display:flex;align-items:center;justify-content:center;padding:40px}
.d-auth-card{background:var(--sur);border:0.5px solid var(--bdr);border-radius:var(--r);padding:36px;width:100%;max-width:380px}
.d-field{margin-bottom:16px}
.d-field label{font-size:12px;color:var(--ink2);display:block;margin-bottom:5px;font-weight:500}
.d-field input{width:100%;padding:11px 14px;font-size:13px;border:0.5px solid var(--bdr2);border-radius:var(--rm);background:var(--sur);color:var(--ink);font-family:inherit;outline:none;transition:.15s}
.d-field input:focus{border-color:var(--br)}
.d-login-btn{width:100%;background:var(--br);color:#fff;border:none;border-radius:var(--rm);padding:13px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit}
.d-login-btn:hover{background:var(--brd)}
.d-social{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.d-social-btn{padding:11px;font-size:13px;border:0.5px solid var(--bdr2);border-radius:var(--rm);background:var(--sur);color:var(--ink);cursor:pointer;font-family:inherit}
.d-social-btn:hover{background:var(--sur2)}

/* Desktop Footer */
.d-footer{background:var(--sur);border-top:0.5px solid var(--bdr);padding:20px 40px;display:flex;justify-content:space-between;align-items:center}
.fn-link{font-size:12px;color:var(--ink3);cursor:pointer}.fn-link:hover{color:var(--ink)}

/* ═══════════════════════════════
   MOBILE VERSION
═══════════════════════════════ */
#mobileView{background:#F0F0F7;display:none;justify-content:center;padding:24px 16px 80px;min-height:100vh}

.m-shell{width:375px;background:var(--sur2);border-radius:40px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,.18);position:relative;display:flex;flex-direction:column}
.m-status{background:var(--sur);padding:12px 24px 8px;display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.m-status-time{font-size:13px;font-weight:600;color:var(--ink)}

.m-bottom-nav{background:rgba(255,255,255,.95);backdrop-filter:blur(12px);border-top:0.5px solid var(--bdr);display:flex;flex-shrink:0}
.m-bn{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 8px 16px;cursor:pointer;transition:.15s}
.m-bn-icon{font-size:20px;line-height:1}
.m-bn-label{font-size:10px;font-weight:500;color:var(--ink3)}
.m-bn.on .m-bn-label{color:var(--br)}

.m-pg{display:none;flex-direction:column;flex:1;overflow-y:auto}
.m-pg.on{display:flex}

/* Mobile Home */
.m-header{background:var(--sur);padding:16px 20px;display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.m-hero{background:linear-gradient(135deg,#1A1A2E,#2A1A10);padding:24px 20px 28px;position:relative;overflow:hidden;flex-shrink:0}
.m-hero::after{content:'';position:absolute;top:-40px;right:-40px;width:180px;height:180px;border-radius:50%;background:rgba(242,100,25,.12);pointer-events:none}
.m-balance-card{background:rgba(255,255,255,.06);border:0.5px solid rgba(255,255,255,.1);border-radius:14px;padding:16px;position:relative;z-index:1}
.m-qas{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:16px 16px 0}
.m-qa{background:var(--sur);border-radius:14px;padding:14px 8px;display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;transition:.15s;border:0.5px solid var(--bdr)}
.m-qa:active{transform:scale(.96);background:var(--brl)}
.m-section-hdr{display:flex;justify-content:space-between;align-items:center;padding:18px 20px 10px}
.m-bill-card{background:var(--sur);border-radius:14px;margin:0 16px 12px;border:0.5px solid var(--bdr);overflow:hidden}
.m-bill-item{display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer;transition:.1s}
.m-bill-item:active{background:var(--sur2)}
.m-bill-item+.m-bill-item{border-top:0.5px solid var(--bdr)}
.m-bill-icon{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.m-status-due{font-size:10px;font-weight:600;padding:3px 8px;border-radius:100px;margin-top:3px;display:inline-block;background:#FFF3EB;color:var(--br)}
.m-coin-banner{background:linear-gradient(135deg,var(--brl),#FFF8F4);border:0.5px solid var(--brm);border-radius:14px;margin:0 16px 20px;padding:16px;display:flex;align-items:center;justify-content:space-between}

/* Mobile Payment */
.m-pay-hdr{background:var(--sur);padding:16px 20px;display:flex;align-items:center;gap:12px;border-bottom:0.5px solid var(--bdr);flex-shrink:0}
.m-back{width:32px;height:32px;border-radius:10px;background:var(--sur2);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:18px;color:var(--ink2)}
.m-pay-body{flex:1;padding:16px;display:flex;flex-direction:column;gap:12px;overflow-y:auto}
.m-pay-card{background:var(--sur);border-radius:14px;border:0.5px solid var(--bdr);overflow:hidden}
.m-pay-item{display:flex;align-items:center;gap:10px;padding:12px 14px}
.m-pay-item+.m-pay-item{border-top:0.5px solid var(--bdr)}
.m-pay-ico{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:16px}
.m-pay-total{display:flex;justify-content:space-between;padding:11px 14px;border-top:0.5px solid var(--bdr2)}
.m-method-opt{display:flex;align-items:center;gap:9px;padding:13px 16px;border:1.5px solid var(--bdr);border-radius:12px;cursor:pointer;transition:.15s;background:var(--sur);margin-bottom:8px}
.m-method-opt.sel{border-color:var(--br);background:var(--brl)}
.m-radio{width:17px;height:17px;border-radius:50%;border:1.5px solid var(--bdr2);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.15s}
.m-method-opt.sel .m-radio{border-color:var(--br);background:var(--br)}
.m-rdot{width:6px;height:6px;border-radius:50%;background:#fff}
.m-mlogo{font-size:9px;font-weight:700;background:var(--ink);color:#fff;border-radius:5px;padding:3px 6px}
.m-fps{background:#E31837}
.m-coin-row{background:var(--brl);border:0.5px solid var(--brm);border-radius:14px;padding:12px 14px;display:flex;align-items:center;justify-content:space-between}
.m-pay-footer{padding:16px;background:var(--sur);border-top:0.5px solid var(--bdr);flex-shrink:0}
.m-confirm-btn{width:100%;background:var(--br);color:#fff;border:none;border-radius:14px;padding:16px;font-size:15px;font-weight:700;cursor:pointer;font-family:'Noto Sans TC',sans-serif;transition:.15s}
.m-confirm-btn:active{background:var(--brd)}

/* Mobile Coin */
.m-coin-hero{background:linear-gradient(135deg,var(--br),#E8440A);padding:32px 20px;text-align:center;flex-shrink:0}
.m-coin-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;padding:16px}
.m-coin-stat{background:var(--sur);border:0.5px solid var(--bdr);border-radius:12px;padding:14px;text-align:center}
.m-redeem-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:0 16px 20px}
.m-redeem-card{background:var(--sur);border:0.5px solid var(--bdr);border-radius:14px;padding:16px;cursor:pointer;transition:.15s}
.m-redeem-card:active{background:var(--brl);border-color:var(--brm)}

/* Mobile Profile */
.m-profile-hdr{background:linear-gradient(135deg,#1A1A2E,#2A1A10);padding:32px 20px 24px;text-align:center;flex-shrink:0}
.m-avatar-lg{width:72px;height:72px;border-radius:50%;background:var(--brl);border:3px solid var(--brm);display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 12px}
.m-menu{background:var(--sur);border-radius:14px;margin:16px 16px 0;border:0.5px solid var(--bdr);overflow:hidden}
.m-menu-item{display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer;transition:.1s}
.m-menu-item:active{background:var(--sur2)}
.m-menu-item+.m-menu-item{border-top:0.5px solid var(--bdr)}
.m-menu-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}

/* SHARED MODAL */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);align-items:center;justify-content:center;z-index:9998}
.modal-bg.show{display:flex}
.modal-web{background:var(--sur);border-radius:var(--r);padding:32px;width:320px;text-align:center;animation:pop .25s cubic-bezier(.34,1.56,.64,1)}
.modal-mobile{background:var(--sur);border-radius:24px 24px 0 0;padding:28px 24px 40px;width:100%;max-width:420px;position:fixed;bottom:0;animation:slideUp .3s cubic-bezier(.34,1.2,.64,1)}
@keyframes pop{from{opacity:0;transform:scale(.85)}to{opacity:1;transform:scale(1)}}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-handle{width:36px;height:4px;border-radius:2px;background:var(--bdr2);margin:0 auto 20px}
.modal-coin-box{background:var(--brl);border:0.5px solid var(--brm);border-radius:var(--rm);padding:14px;margin:14px 0}

#page-payment .view-switcher{display:none !important;}
#page-payment #mobileView{display:none !important;}

/* ── Nav More Dropdown ── */
.nav-more { position: relative; }
.nav-more-btn { font-size: var(--text-sm) !important; }
.nav-more-drop {
  display: none; position: absolute; top: calc(var(--nav-h) + 4px);
  left: 50%; transform: translateX(-50%);
  background: var(--sur); border: 1px solid var(--bdr);
  border-radius: var(--r-lg); box-shadow: var(--shadow-md);
  padding: 6px; min-width: 160px; z-index: 50;
}
.nav-more-drop.open { display: block; }
.nav-drop-item {
  display: flex; align-items: center; gap: 8px;
  width: 100%; padding: 9px 12px; font-size: var(--text-sm);
  color: var(--ink-2); background: none; border: none;
  border-radius: var(--r-md); cursor: pointer;
  font-family: var(--font); text-align: left;
  transition: background .12s;
}
.nav-drop-item:hover { background: var(--sur-2); color: var(--ink); }

/* Nav-r cleaner */
.nav-r { font-size: var(--text-sm) !important; }
.nav-r span { color: var(--ink-3) !important; cursor: pointer; }
.nav-r span:hover { color: var(--ink) !important; }
body.dark{
  --ink:#F4F6FB;
  --ink-2:#CBD5E1;
  --ink-3:#94A3B8;
  --ink-4:#64748B;
  --sur:#111827;
  --sur-2:#0B1120;
  --sur-3:#1F2937;
  --bdr:#263244;
  --bdr-2:#334155;
  --brand-light:rgba(240,90,0,.18);
  --shadow-sm:0 1px 4px rgba(0,0,0,.28);
  --shadow-md:0 6px 18px rgba(0,0,0,.34);
