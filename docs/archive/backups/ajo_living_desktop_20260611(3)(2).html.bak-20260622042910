function openPriceModal(name,brand){
  document.getElementById('modal-prod-name').textContent=name;
  document.getElementById('modal-prod-brand').textContent=brand;
  // build chart
  var chart=document.getElementById('price-chart');
  chart.innerHTML='';
  var prices=[35.9,35.9,28,35.9,22,35.9,29,35.9,14.5];
  var labels=['5/9','5/14','5/19','5/24','5/29','6/1','6/3','6/5','今日'];
  var max=Math.max.apply(null,prices);
  prices.forEach(function(p,i){
    var col=document.createElement('div');col.className='price-bar-col';
    var bar=document.createElement('div');bar.className='price-bar-val'+(i===prices.length-1?' now':(p<20?' hi':''));
    bar.style.height=Math.round((p/max)*70)+'px';bar.style.width='100%';
    var lbl=document.createElement('div');lbl.className='price-bar-label';lbl.textContent=labels[i];
    col.appendChild(bar);col.appendChild(lbl);chart.appendChild(col);
  });
  document.getElementById('price-modal').classList.add('open');
}
