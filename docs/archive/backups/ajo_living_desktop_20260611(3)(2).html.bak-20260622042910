function addToSaved(card) {
  if (!card) return;
  var name = card.dataset.name;
  var price = card.dataset.price;
  var area = card.dataset.area;
  var rooms = card.dataset.rooms;
  var district = card.dataset.district;
  if (savedItems.some(function(i){return i.name===name;})) { showToast('已在收藏清單中'); return; }
  savedItems.push({name:name,price:price,area:area,rooms:rooms,district:district,bg:'linear-gradient(160deg,#e8e8e8,#d0d0d0)',note:''});
  renderSaved();
}

function removeSaved(i) {
  savedItems.splice(i, 1);
  renderSaved();
  showToast('已移除收藏');
}

function sortSaved(by) {
  if (by === 'price-asc') savedItems.sort(function(a,b){ return parseInt(a.price.replace(/[^0-9]/g,'')) - parseInt(b.price.replace(/[^0-9]/g,'')); });
  else if (by === 'price-desc') savedItems.sort(function(a,b){ return parseInt(b.price.replace(/[^0-9]/g,'')) - parseInt(a.price.replace(/[^0-9]/g,'')); });
  renderSaved();
}

