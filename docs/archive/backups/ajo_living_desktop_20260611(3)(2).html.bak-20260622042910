.d-hero-left{flex:1}
.d-hero-badge{display:inline-flex;align-items:center;gap:6px;background:var(--brl);color:var(--br);font-size:12px;font-weight:600;padding:5px 12px;border-radius:100px;margin-bottom:20px}
.d-hero-title{font-size:44px;font-weight:700;color:var(--ink);line-height:1.15;font-family:'Noto Sans TC',sans-serif}
.d-hero-sub{font-size:16px;color:var(--ink2);margin-top:16px;line-height:1.7;max-width:480px}
.d-hero-btns{display:flex;gap:12px;margin-top:28px}
.d-hero-btn1{background:var(--br);color:#fff;border:none;padding:13px 28px;border-radius:var(--rm);font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;transition:.15s}
.d-hero-btn1:hover{background:var(--brd)}
.d-hero-btn2{background:transparent;color:var(--ink);border:0.5px solid var(--bdr2);padding:12px 24px;border-radius:var(--rm);font-size:14px;cursor:pointer;font-family:inherit;transition:.15s}
