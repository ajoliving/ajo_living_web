function calcRent(){
  var rent=parseFloat(document.getElementById('calc-rent').value)||0;
  var income=parseFloat(document.getElementById('calc-income').value)||0;
  var sqft=parseFloat(document.getElementById('calc-sqft').value)||0;
  if(!rent){
    document.getElementById('cr-annual').textContent='—';
    document.getElementById('cr-psf').textContent='—';
    document.getElementById('cr-ratio').textContent='—';
    document.getElementById('cr-advice').textContent='輸入數據後顯示';
    return;
  }
  var annual='HK$'+Math.round(rent*12).toLocaleString();
  var psf=sqft>0?'HK$'+Math.round(rent/sqft).toLocaleString()+' /呎':'需要輸入面積';
  var ratio=income>0?Math.round(rent/income*100)+'%':'需要輸入收入';
  var ratioNum=income>0?rent/income*100:0;
  var advice=ratioNum===0?'輸入收入後顯示':ratioNum<=30?'✓ 合理範圍（≤30%）':ratioNum<=40?'⚠ 略高（建議≤30%）':'✗ 偏高（建議控制在30%以內）';
  document.getElementById('cr-annual').textContent=annual;
  document.getElementById('cr-psf').textContent=psf;
  var ratioEl=document.getElementById('cr-ratio');
  ratioEl.textContent=ratio;
  ratioEl.className='calc-result-val'+(ratioNum>40?' warn':ratioNum>0&&ratioNum<=30?' ok':'');
  var advEl=document.getElementById('cr-advice');
  advEl.textContent=advice;
  advEl.className='calc-result-val'+(ratioNum>40?' warn':ratioNum>0&&ratioNum<=30?' ok':'');
}

