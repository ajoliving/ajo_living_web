.dnl:hover,.dnl.a{color:var(--br);background:var(--brl)}
.d-nav-r{display:flex;gap:8px;align-items:center}
.btn-ol{padding:8px 18px;font-size:13px;border:0.5px solid var(--bdr2);border-radius:var(--rm);cursor:pointer;color:var(--ink);background:transparent;font-family:inherit;transition:.15s}
